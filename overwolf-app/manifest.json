{
 "manifest_version": 1,
 "type": "WebApp",
 "meta": {
  "name": "ARAM Mayhem Helper",
  "author": "personal",
  "version": "1.0.0",
  "minimum-overwolf-version": "0.240.0",
  "description": "Tier de augmente si build adaptat la compozitie, in ARAM Mayhem",
  "icon": "icon.png",
  "icon_gray": "icon_gray.png"
 },
 "permissions": ["GameInfo", "Web", "FileSystem"],
 "data": {
  "game_targeting": { "type": "dedicated", "game_ids": [5426] },
  "game_events": [5426],
  "launch_events": [
   {
    "event": "GameLaunch",
    "event_data": { "game_ids": [5426] },
    "start_minimized": true
   }
  ],
  "start_window": "background",
  "externally_connectable": { "matches": ["https://u.gg", "https://*.u.gg"] },
  "windows": {
   "background": {
    "file": "background/background.html",
    "is_background_page": true
   },
   "overlay": {
    "file": "overlay/overlay.html",
    "in_game_only": true,
    "transparent": true,
    "clickthrough": false,
    "resizable": false,
    "topmost": true,
    "size": { "width": 380, "height": 540 },
    "start_position": { "top": 40, "left": 40 }
   },
   "scraper": {
    "file": "overlay/scraper.html",
    "is_background_page": true
   }
  }
 }
}
